# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""
# GEMINI_MODEL: The model to use for Gemini AI (e.g. gemini-1.5-flash)
GEMINI_MODEL="gemini-3.1-flash-lite"
# GEMINI_API_BASEURL: Optional base URL for Gemini API (e.g. for proxy)
GEMINI_API_BASEURL="https://generativelanguage.googleapis.com"

# JWT_SECRET: Secret for signing session tokens
JWT_SECRET="assets-inventory-secret-change-me"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
